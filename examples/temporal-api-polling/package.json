{
  "name": "temporal-api-polling",
  "version": "1.0.0",
  "description": "Temporal.io example: poll an external HTTP API until a job reaches a terminal state",
  "private": true,
  "scripts": {
    "mock-api":  "ts-node src/mock-api/server.ts",
    "worker":    "ts-node src/temporal/worker.ts",
    "client":    "ts-node src/temporal/client.ts",
    "build":     "tsc",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@temporalio/activity": "^1.11.0",
    "@temporalio/client":   "^1.11.0",
    "@temporalio/worker":   "^1.11.0",
    "@temporalio/workflow":  "^1.11.0",
    "express": "^4.19.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node":    "^20.0.0",
    "ts-node":        "^10.9.2",
    "typescript":     "^5.4.0"
  }
}
