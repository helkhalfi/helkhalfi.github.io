{
    "name": "helkhalfi.github.io – Pelican blog",
    "build": {
        "dockerfile": "./Dockerfile",
        // context is the .devcontainer/ folder; the workspace is mounted separately
        "context": "."
    },
    "features": {
        // Common CLI utilities + Oh My Zsh (git, curl, etc. already in Dockerfile)
        "ghcr.io/devcontainers/features/common-utils:2": {
            "installOhMyZsh": "true",
            "username": "vscode",
            "userUid": "1000",
            "userGid": "1000",
            "upgradePackages": "true"
        },
        // Latest git from PPA for better credential handling
        "ghcr.io/devcontainers/features/git:1": {
            "version": "latest",
            "ppa": "false"
        }
    },
    "customizations": {
        "vscode": {
            "settings": {
                // Point VS Code at the uv-managed virtual environment
                "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
                "python.terminal.activateEnvironment": true,
                // Pelican content is Markdown — enable word wrap
                "[markdown]": {
                    "editor.wordWrap": "on",
                    "editor.rulers": [100]
                }
            },
            "extensions": [
                // Python support
                "ms-python.python",
                "ms-python.pylance",
                // Markdown authoring
                "yzhang.markdown-all-in-one",
                "davidanson.vscode-markdownlint",
                // Spell-check blog content
                "streetsidesoftware.code-spell-checker",
                // YAML / TOML config files
                "redhat.vscode-yaml",
                "tamasfe.even-better-toml",
                // Pelican / Jinja2 templates
                "samuelcolvin.jinjahtml"
            ]
        }
    },
    // Forward the Pelican dev-server port so the browser on the host can reach it
    "forwardPorts": [8000],
    "portsAttributes": {
        "8000": {
            "label": "Pelican dev server",
            "onAutoForward": "notify"
        }
    },
    // After the container is created:
    //   1. install all Python deps via uv
    //   2. clone + install the Flex Pelican theme
    "postCreateCommand": "bash .devcontainer/setup.sh",
    "remoteUser": "vscode"
}
